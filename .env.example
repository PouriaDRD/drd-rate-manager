APP_VERSION=0.13.0
BOT_DISPLAY_NAME=DRD Rate Manager
TIMEZONE=Asia/Tehran

# Legacy secret migration inputs
# After APP_MASTER_KEY is configured and migration is verified, these can be removed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
