# ---------------------------------------------------------------------------
# PERMANENT DEPLOYMENT IDENTITY
# These are not D1 runtime settings and remain deployment-level values.
# ---------------------------------------------------------------------------
APP_NAME=DRD RATE MANAGER
APP_VERSION=0.2.1

# ---------------------------------------------------------------------------
# PERMANENT INFRASTRUCTURE SECRET
# Generate a 32-byte base64 key, for example: openssl rand -base64 32
# Production: wrangler secret put APP_MASTER_KEY
# Never place a real production master key in wrangler.jsonc.
# ---------------------------------------------------------------------------
APP_MASTER_KEY=

# ---------------------------------------------------------------------------
# LEGACY MIGRATION INPUTS — SECURE SETTINGS
# SecureSettingsService migrates these to encrypted D1 when APP_MASTER_KEY is
# configured. Do not remove these from an existing production environment until
# System diagnostics reports Legacy ENV cleanup as READY.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
COINGECKO_API_KEY=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY MIGRATION INPUTS — RUNTIME SETTINGS
# D1 runtime settings are the source of truth after migration. These values are
# retained only for bootstrap/backward compatibility until readiness is verified.
# ---------------------------------------------------------------------------
BOT_DISPLAY_NAME=DRD Rate Manager
TIMEZONE=Asia/Tehran

TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=@DRDrate
TELEGRAM_CHANNEL_HANDLE=@DRDrate

COINGECKO_API_PLAN=demo
COINGECKO_TOP_LIMIT=20
COINGECKO_DEFAULT_ASSETS=bitcoin,ethereum,binancecoin,ripple,solana,tron
COINGECKO_USER_AGENT=DRD-Rate-Manager/0.2.1 (+https://t.me/DRDrate)

