# Infrastructure secret
# Generate a 32-byte base64 key, for example: openssl rand -base64 32
# In production configure this with: wrangler secret put APP_MASTER_KEY
APP_MASTER_KEY=

# Application (legacy migration/fallback values; moved to D1 runtime settings)
