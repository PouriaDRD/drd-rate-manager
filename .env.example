# ---------------------------------------------------------------------------
# PERMANENT DEPLOYMENT IDENTITY
# These remain deployment-level values and are not D1 runtime settings.
# ---------------------------------------------------------------------------
APP_NAME=DRD RATE MANAGER
APP_VERSION=0.2.1

# ---------------------------------------------------------------------------
# PERMANENT INFRASTRUCTURE SECRET
# Generate a 32-byte base64 key, for example: openssl rand -base64 32
# Production: wrangler secret put APP_MASTER_KEY
# Never place a real production master key in wrangler.jsonc or source control.
# ---------------------------------------------------------------------------
APP_MASTER_KEY=

# ---------------------------------------------------------------------------
# D1-MANAGED APPLICATION CONFIGURATION
#
# Current architecture:
# - 25 Runtime Settings are owned by D1.
# - 4 Secure Settings are encrypted in D1 under APP_MASTER_KEY.
# - Runtime/provider values are managed through the private Configuration UI.
# - Secure values are replace-only and their plaintext is never returned.
#
# Legacy runtime ENV assignments and legacy Worker-secret assignments are
# intentionally NOT part of this template after the completed v0.2.1 cleanup.
# Compatibility fallback code remains only for older installations/migrations.
# Do not reintroduce legacy ENV/Worker secrets into a cleaned deployment.
# ---------------------------------------------------------------------------
